<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for downloading optional on-device AI models and loading AdMob ads -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Required for voiceover recording inside the video editor -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Advertising ID permission for Android 13+ (Google AdMob) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Video Editor"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- Google AdMob Application ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${ADMOB_APP_ID}" />

        <activity
            android:name=".VideoEditorActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale|fontWeightAdjustment|locale|layoutDirection"
            android:exported="true"
            android:label="Video Editor"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">

            <!-- Tells NativeActivity to load Rust's libconcat_android.so -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="concat_android" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
